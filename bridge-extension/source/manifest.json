{
  "manifest_version": 3,
  "name": "Omarchy Task Manager Tabs",
  "version": "0.1.0",
  "description": "Shares your browser's open tab titles with the Omarchy Task Manager plugin, locally. Nothing leaves your computer; no accounts, no network calls.",
  "key": "",
  "permissions": ["nativeMessaging", "tabs"],
  "background": { "service_worker": "background.js" },
  "icons": { "128": "icon.png" }
}
