[Unit]
Description=Omarchy Task Manager memory-pressure watchdog
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=@PLUGIN_DIR@/bin/task-manager-launch.sh watch
# Never leave memory.high limits behind (stop, crash, restart).
ExecStopPost=@PLUGIN_DIR@/bin/task-manager-launch.sh governor-release
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
